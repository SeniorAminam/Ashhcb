# ---------- Bale Bot ----------
BOT_TOKEN=your_bot_token_here
BALE_API_BASE=https://tapi.bale.ai/bot{token}
BALE_FILE_BASE=https://tapi.bale.ai/file/bot{token}

# ---------- Admin ----------
ADMIN_USER_IDS=your_admin_user_id

# ---------- AI Service (OpenAI-compatible, e.g., Gemma 4) ----------
AI_API_KEY=sk-your-ai-api-key
AI_BASE_URL=https://your-ai-endpoint/v1
AI_MODEL_CHAT=Iag4a/Gemma-4-26B-A4B-it
AI_MODEL_VISION=Iag4a/Gemma-4-26B-A4B-it

# ---------- Legacy (deprecated) ----------
AGNES_API_KEY=sk-your-legacy-api-key

# ---------- Bot Limits ----------
MAX_PHOTO_SIZE_MB=10
DOWNLOAD_TIMEOUT=60
API_TIMEOUT=120
RATE_LIMIT_SECONDS=60

# ---------- Feature Flags ----------
ENABLE_WEB_SEARCH=true
ENABLE_SCRAPERS=true
DEFAULT_LANGUAGE=fa

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false