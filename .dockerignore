# Git
.git
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
venv/
venv_*

# Local env (production uses .env mounted at runtime)
.env

# Database and data
*.db
data/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp
tmp/
temp/
test_*.jpg

# Docs (not needed in runtime image)
docs/
README.md
LICENSE
RULES.md
AGENTS.md
